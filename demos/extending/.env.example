# The Acme bundle ships a STUB backend connection (see acme-bundle-src/src/kx_mcp_acme/utils/acme.py),
# so the demo runs with no real server. These ACME_DB_* values configure that stub — the
# acme_list_widgets tool echoes back the host:port it "connected" to, so you can see the config flow
# through. A real backend would dial these (and add TLS, auth, an outbound strategy, …). The health
# check runs fine with none of this set (the defaults below are the built-in values).

# --- the Acme backend config fragment (ACME_DB_*) ---
export ACME_DB_HOST=127.0.0.1
export ACME_DB_PORT=9000
# export ACME_DB_TIMEOUT=1

# --- optional: validate inbound bearers at the container (jwks mode) ---
# export KX_MCP_AUTH=jwks
# export KX_MCP_AUTH_JWKS_URI="https://your-idp/realms/quants/protocol/openid-connect/certs"
# export KX_MCP_AUTH_ISSUER="https://your-idp/realms/quants"
# export KX_MCP_AUTH_AUDIENCE=account
# export KX_MCP_AUTH_RESOURCE_URL="http://127.0.0.1:8000"   # advertise RFC 9728 discovery
