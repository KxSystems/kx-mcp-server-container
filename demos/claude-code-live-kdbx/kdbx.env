# Sourceable config for running the container as a jwks-protected HTTP MCP server against a local
# kdb-x host, with both the capability check (PEP-1) and the data gate (PEP-2) authorization on.
#
#   source tests/deterministic/realidp/envs/.env.keycloak   # KC_BASE / KC_REALM / KC_CLIENT_ID / audience
#   set -a; source demos/claude-code-live-kdbx/kdbx.env; set +a
#   uv run kx-mcp --bundles kdbx --transport streamable-http --host 127.0.0.1 --port 8000
#
# .env.keycloak's clients all carry the `groups` mapper the policy keys on (generalized onto every
# provisioned client, not just kdbai-service's), so this is the same fixture `just test-kdbx` uses —
# no bespoke kdb-x fixture or kdbai-fixture borrow needed.
# Point at a different Keycloak by exporting KC_BASE / KC_REALM before sourcing. This is the whole
# config surface — the stock `kx-mcp` launcher reads these from the env (no bespoke launch script).

KC_BASE="${KC_BASE:-http://localhost:8080}"
KC_REALM="${KC_REALM:-quants}"

# --- inbound: validate the caller's bearer against the realidp Keycloak (the quants realm) ---
# jwks mode also advertises the RFC 9728 / 401 discovery metadata an MCP client (Claude Code) needs.
export KX_MCP_AUTH=jwks
export KX_MCP_AUTH_JWKS_URI="$KC_BASE/realms/$KC_REALM/protocol/openid-connect/certs"
export KX_MCP_AUTH_ISSUER="$KC_BASE/realms/$KC_REALM"
export KX_MCP_AUTH_AUDIENCE="${KX_MCP_AUTH_AUDIENCE:-kdbai-service}"   # = KC_CLIENT_ID the persona tokens carry
# The container's public URL — set => advertise discovery so Claude Code can navigate its own login.
export KX_MCP_AUTH_RESOURCE_URL="http://127.0.0.1:8000"

# --- outbound: identity assertion to plain kdb-x (no token exchange — qIPC has no bearer) ---
export KDBX_DB_HOST="${KDBX_DB_HOST:-127.0.0.1}"
export KDBX_DB_PORT="${KDBX_DB_PORT:-5010}"
# The data gate (PEP-2): project + bind the validated principal so the q-side .s.e wrapper can gate on it.
export KDBX_DB_ASSERT_IDENTITY=true
# The capability check (PEP-1): the SQL tool's @authorize(action="query", resource="kdbx:sql") decorator.
# KX_MCP_AUTHZ=kdbx_rbac routes that check to q .kx.auth container-side with the MCP-semantic
# (action;resource) over the capability grant set, ahead of the data gate. Distinct semantic RBAC
# set, same engine. (A capability deny raises a clean AuthorizationDenied tool error; unset = route-only.)
export KX_MCP_AUTHZ=kdbx_rbac
# Tier 0 service account — must match the `-U <userpass>` host.q is started with (see manual.md).
export KDBX_DB_USERNAME="${KDBX_DB_USERNAME:-kxmcp}"
export KDBX_DB_PASSWORD="${KDBX_DB_PASSWORD:-s3cret-svc-pw}"
