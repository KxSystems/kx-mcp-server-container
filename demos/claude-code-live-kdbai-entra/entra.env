# Shared environment for the claude-code-live-kdbai-entra demo container.
#
# Unlike the Keycloak demo's kdbai.env, this file references ${ENTRA_*} vars rather than
# hardcoding them — those live in the gitignored tests/deterministic/realidp/envs/.env.entra
# (provisioned by entra_setup.py). Source BOTH files, in this order, before launching:
#
#   set -a
#   source tests/deterministic/realidp/envs/.env.entra
#   source demos/claude-code-live-kdbai-entra/entra.env
#   set +a
#
# KX_MCP_AUTH_RESOURCE_URL is intentionally omitted here and set at launch time instead — it
# MUST be http://localhost:8000 to match the redirect URI Entra has registered for this app
# (ENTRA_REDIRECT_URI in .env.entra, default http://localhost:8000/auth/callback). Changing the
# port without re-registering the redirect URI in the Entra portal will fail with AADSTS50011.

# ---------------------------------------------------------------------------
# Inbound auth — KX_MCP_AUTH=entra (FastMCP AzureProvider), NOT jwks.
#
# Entra has no open Dynamic Client Registration (unlike Keycloak), so the validate-only `jwks`
# mode the Keycloak demo uses cannot drive an interactive login — it can only check a token
# that's already been minted elsewhere. AzureProvider is the OAuthProxy that presents a
# DCR-compatible facade to Claude Code while brokering the real login with Entra through this
# one pre-registered app (kdbai-service-mcp-agent). Everything downstream (JWTVerifier,
# passthrough, kdbai-db ACL) is unchanged from the jwks path.
# ---------------------------------------------------------------------------
KX_MCP_AUTH=entra
KX_MCP_AUTH_CLIENT_ID=${ENTRA_CLIENT_ID}
KX_MCP_AUTH_CLIENT_SECRET=${ENTRA_CLIENT_SECRET}
KX_MCP_AUTH_TENANT_ID=${ENTRA_TENANT_ID}
KX_MCP_AUTH_REQUIRED_SCOPES=access

# ---------------------------------------------------------------------------
# Outbound identity — passthrough forwards the inbound bearer to kdbai-db as the qipc
# connection password. kdbai-db reads tid + groups from the JWT and enforces its ACL grants.
#
# CRITICAL: without this, the pre-flight does an anonymous connect, kdbai-db rejects it (auth
# required), and the container exits(1) before mounting.
# ---------------------------------------------------------------------------
KDBAI_DB_OUTBOUND_STRATEGY=passthrough

# ---------------------------------------------------------------------------
# KDB.AI backend connection — the Entra-trusting kdbai-db from the test lane
# (tests/deterministic/realidp/setup/entra/docker-compose.yaml).
# ---------------------------------------------------------------------------
KDBAI_DB_HOST=127.0.0.1
KDBAI_DB_PORT=8082
KDBAI_DB_MODE=qipc
