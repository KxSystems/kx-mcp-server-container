# Shared environment for the claude-code-live-kdbai demo containers.
#
# Source this before launching each container:
#   set -a; source demos/claude-code-live-kdbai/kdbai.env; set +a
#
# Then add the per-container overrides on the command line:
#   KX_MCP_AUTH_RESOURCE_URL=http://localhost:8000  uv run kx-mcp --bundles kdbai --port 8000
#   KX_MCP_AUTH_RESOURCE_URL=http://localhost:8001  uv run kx-mcp --bundles kdbai --port 8001
#
# KX_MCP_AUTH_RESOURCE_URL is intentionally omitted here — it differs per container (port 8000 vs
# 8001) and must be set at launch time. Without it the container still validates tokens (correct),
# but does not advertise RFC 9728 discovery (the native login flow won't work).

# ---------------------------------------------------------------------------
# Inbound auth — the container validates inbound JWTs against the quants realm.
# ---------------------------------------------------------------------------
KX_MCP_AUTH=jwks
KX_MCP_AUTH_JWKS_URI=http://localhost:8080/realms/quants/protocol/openid-connect/certs
KX_MCP_AUTH_ISSUER=http://localhost:8080/realms/quants
KX_MCP_AUTH_AUDIENCE=kdbai-service

# ---------------------------------------------------------------------------
# Outbound identity — passthrough forwards the inbound bearer to kdbai-db
# as the qipc connection password.  kdbai-db reads tenant + groups from the
# JWT and enforces its ACL grants.
#
# CRITICAL: without this, the pre-flight does an anonymous connect, kdbai-db
# rejects it (auth required), and the container exits(1) before mounting.
# ---------------------------------------------------------------------------
KDBAI_DB_OUTBOUND_STRATEGY=passthrough

# ---------------------------------------------------------------------------
# KDB.AI backend connection
# ---------------------------------------------------------------------------
KDBAI_DB_HOST=127.0.0.1
KDBAI_DB_PORT=8082
KDBAI_DB_MODE=qipc
