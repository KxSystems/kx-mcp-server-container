# Real-IdP harness — Microsoft Entra ID configuration (cross-IdP gate)
# Run all commands from the repo root.
#
# First-time setup (skip if you already have a populated .env.entra):
#   1. cp tests/deterministic/realidp/envs/.env.entra.example \
#         tests/deterministic/realidp/envs/.env.entra
#   2. Fill in the INPUT vars below, then:
#      source tests/deterministic/realidp/envs/.env.entra
#      uv run python tests/deterministic/realidp/setup/entra/entra_setup.py
#      (writes ENTRA_DOMAIN, group Object IDs, and KX_MCP_AUTH_* back into .env.entra)
#
# Returning operators: skip step 1 — entra_setup.py preserves your existing values.
#
# .env.entra is gitignored — do not commit the filled-in copy.

export AUTH_PROVIDER="entra"

# =============================================================================
# INPUTS — fill these before running entra_setup.py (first-time only)
# =============================================================================

# Directory (tenant) ID from the kdbai-service-mcp-agent app registration Overview
export ENTRA_TENANT_ID=

# Application (client) ID of kdbai-service-mcp-agent
export ENTRA_CLIENT_ID=

# Secret Value — create this manually in the portal (App registration → Certificates & secrets)
# and paste it here. Required before running entra_setup.py (used to authenticate to Graph).
# entra_setup.py will also create a separate "fastmcp-auto-generated" secret for runtime use.
export ENTRA_CLIENT_SECRET=

# Primary tenant domain (e.g. yourtenant.onmicrosoft.com) — visible in the Azure portal
# as the primary domain of the tenant. Set this to avoid requiring Organization.Read.All.
export ENTRA_DOMAIN=

# Per-user passwords for the ROPC (password grant) flow.
# Never committed — inject manually or as masked CI variables.
export ENTRA_PASSWORD_ROOT=
export ENTRA_PASSWORD_ALICE=
export ENTRA_PASSWORD_BOB=

# Second Entra tenant — charlie wrong-issuer persona (test 2.41).
# Leave blank to skip test_wrong_issuer_token_rejected under AUTH_PROVIDER=entra.
# Set these once a second tenant is available to activate the test automatically.
export ENTRA_TENANT_ID_RISK=
export ENTRA_DOMAIN_RISK=
export ENTRA_PASSWORD_CHARLIE=

# =============================================================================
# OUTPUTS — populated by entra_setup.py (leave blank; the script fills these in)
# =============================================================================

# OAuth scope for the ROPC flow (e.g. api://<client-id>/access offline_access)
export ENTRA_SCOPE=

# Group Object IDs written by entra_setup.py, e.g.:
# export ENTRA_GROUP_QUANTS_VIEWER=""
# export ENTRA_GROUP_QUANTS_TRADER=""
# ... (one per namespace-group combination)

# kdbai-db connection (the kdbai ACL lane under Entra — just test-kdbai-entra).
# Under passthrough the inbound token is forwarded UNCHANGED to kdbai-db, so the same
# ENTRA_CLIENT_ID audience serves both hops — no separate resource app. The container's
# KDBAI_DB_OUTBOUND_STRATEGY=passthrough is supplied by the test fixture, not here.
# See setup/entra/docker-compose.yaml + setup/entra/seed.py.
export KDBAI_DB_HOST=127.0.0.1
export KDBAI_DB_PORT=8082
export KDBAI_DB_MODE=qipc

# =============================================================================
# Container inbound validation — also populated by entra_setup.py.
#
# IMPORTANT: confirm these by introspecting a real token BEFORE running tests:
#   uv run kx auth introspect <token> --json
#
# v2 (set by entra_setup.py via requestedAccessTokenVersion=2):
#   iss = https://login.microsoftonline.com/<tid>/v2.0
#   aud = <ENTRA_CLIENT_ID>  (bare GUID, NOT api://<id>)
#
# v1 (legacy default, if your app pre-dates this script):
#   iss = https://sts.windows.net/<tid>/
#   aud = api://<ENTRA_CLIENT_ID>
#
# Fill in to match the decoded token (entra_setup.py writes sensible defaults).
#
# KX_MCP_AUTH must be "jwks" for `kx auth introspect` (run manually, from a sourced
# .env.entra) to validate against these — the test harness itself sets this
# independently on the spawned container subprocess, so it isn't affected by this var.
# =============================================================================
export KX_MCP_AUTH="jwks"
export KX_MCP_AUTH_AUDIENCE=""
export KX_MCP_AUTH_ISSUER=""
export KX_MCP_AUTH_JWKS_URI=""
