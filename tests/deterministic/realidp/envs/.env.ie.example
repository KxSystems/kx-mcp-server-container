# Real-backend harness — kdb Insights Enterprise (IE) configuration
# Copy to envs/.env.ie, fill in IE_REFRESH_TOKEN, then: just test-ie
# .env.ie is gitignored — do not commit real credentials.
#
# Get a refresh token (interactive SSO, once):
#   python demos/live-ie-connect/login.py     # writes demos/live-ie-connect/.refresh
#   cat demos/live-ie-connect/.refresh         # paste into IE_REFRESH_TOKEN below
# IE access tokens live ~5 min; the harness mints a fresh one per session from this.

# Which provider driver to use (keycloak | entra | ie)
AUTH_PROVIDER=ie

# IE base URL (the same host serves Keycloak and the REST API)
IE_BASE=

# Keycloak realm + public client behind IE's SSO
IE_REALM=insights
IE_CLIENT=insights-app

# Long-lived refresh token captured via demos/live-ie-connect/login.py
IE_REFRESH_TOKEN=

# Audience the container expects in the aud claim — insights-app tokens carry "account"
KX_MCP_AUTH_AUDIENCE=account

# Verify IE's TLS cert (set false only against a self-signed dev box)
KXI_DB_SSL_VERIFY=true
