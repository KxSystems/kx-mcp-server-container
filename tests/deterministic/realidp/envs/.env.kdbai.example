# Real-IdP kdbai OAuth ACL lane — configuration
# Copy to envs/.env.kdbai, fill in values, then: source envs/.env.kdbai
# .env.kdbai is gitignored — do not commit the filled-in copy.
#
# Run: just test-kdbai  (sources this file automatically)

# Which IdP driver to use
AUTH_PROVIDER=keycloak

# Keycloak base URL
KC_BASE=http://localhost:8080

# Realm for inbound token validation (the MCP container validates against quants)
KC_REALM=quants

# Public OAuth client — no secret for kdbai-service
KC_CLIENT_ID=kdbai-service
KC_CLIENT_SECRET=

# Audience the container expects in the aud claim
KX_MCP_AUTH_AUDIENCE=kdbai-service

# kdbai-db connection (host networking — kdbai-db binds on the host's port).
# Every KA.* test now runs parametrized over both transport modes automatically (test IDs
# suffixed [qipc]/[rest]) — there is no KDBAI_DB_MODE override; both ports below must be
# reachable on the SAME running kdbai-db (no separate compose service for REST).
KDBAI_DB_HOST=127.0.0.1
KDBAI_DB_PORT=8082
KDBAI_DB_REST_PORT=8081
