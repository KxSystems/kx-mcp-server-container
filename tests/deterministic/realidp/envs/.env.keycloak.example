# Real-IdP harness — Keycloak configuration (inbound-auth + kdbai ACL lane)
# Source before running tests: source tests/deterministic/realidp/envs/.env.keycloak
# .env.keycloak is gitignored — do not commit the filled-in copy.

# Which IdP driver to use (keycloak | entra)
AUTH_PROVIDER=keycloak

# Keycloak base URL (matches KC_HOSTNAME in docker-compose.yaml)
KC_BASE=http://localhost:8080

# Realm the container will validate against (single-issuer; one realm at a time)
KC_REALM=quants

# Public OAuth client registered in each realm (kdbai-service — directAccessGrantsEnabled,
# no client secret). Used by the token provider for inbound-auth tests and the kdbai
# ACL lane.
KC_CLIENT_ID=kdbai-service

# Leave blank for public clients (kdbai-service has no secret).
KC_CLIENT_SECRET=

# Audience the container expects in the aud claim (must match KC_CLIENT_ID)
KX_MCP_AUTH_AUDIENCE=kdbai-service
